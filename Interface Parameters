实验3: Trust Miscalibration (H5)
xml
<experiment name="trust-calibration" repetitions="50" runMetricsEveryStep="false">
  <setup>setup</setup>
  <go>go</go>
  <timeLimit steps="500"/>
  
  <enumeratedValueSet variable="authority-regime">
    <value value="&quot;advisor&quot;"/>
    <value value="&quot;hybrid-voter&quot;"/>
  </enumeratedValueSet>
  
  <!-- Over-trust scenario -->
  <enumeratedValueSet variable="meanTrust">
    <value value="0.85"/>
  </enumeratedValueSet>
  <enumeratedValueSet variable="A">
    <value value="0.65"/>
  </enumeratedValueSet>
  
  <!-- Under-trust scenario -->
  <enumeratedValueSet variable="meanTrust">
    <value value="0.5"/>
  </enumeratedValueSet>
  <enumeratedValueSet variable="A">
    <value value="0.85"/>
  </enumeratedValueSet>
  
  <metrics>accuracy trust-bias trust-drift cascade-rate</metrics>
</experiment>
