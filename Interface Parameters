X axis: ticks
Pens:
  - "polarisation" (color: purple)
  - "conflict-burden" (color: brown)
📊 BehaviorSpace 实验设计
实验1: 基础对比 (H1, H2, H3)
xml
<experiment name="authority-info-structure" repetitions="50" runMetricsEveryStep="false">
  <setup>setup</setup>
  <go>go</go>
  <timeLimit steps="200"/>
  
  <enumeratedValueSet variable="authority-regime">
    <value value="&quot;no-ai&quot;"/>
    <value value="&quot;advisor&quot;"/>
    <value value="&quot;pure-voter&quot;"/>
    <value value="&quot;hybrid-voter&quot;"/>
  </enumeratedValueSet>
  
  <enumeratedValueSet variable="centralized?">
    <value value="false"/>
    <value value="true"/>
  </enumeratedValueSet>
  
  <steppedValueSet variable="A" first="0.6" step="0.1" last="0.9"/>
  <steppedValueSet variable="wAI" first="0.5" step="0.5" last="2"/>
  
  <enumeratedValueSet variable="coverage">
    <value value="0.3"/>
    <value value="0.8"/>
  </enumeratedValueSet>
  
  <metrics>accuracy cascade-rate false-convergence polarisation 
           confidence-calibration influence-inequality conflict-burden
           trust-miscalibration trust-bias trust-drift</metrics>
</experiment>
